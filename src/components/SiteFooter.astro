---
const year = new Date().getFullYear();

const explore = [
  { name: 'Stories', url: '/stories/' },
  { name: 'Projects', url: '/projects/' },
  { name: 'About the Farm', url: '/about/' },
  { name: 'Tools We Use', url: '/tools/' },
  { name: 'All Tags', url: '/tags/' },
];

const fields = [
  { name: 'Crops', url: '/tags/crops/' },
  { name: 'Livestock', url: '/tags/livestock/' },
  { name: 'Seasons', url: '/tags/seasons/' },
  { name: 'Farm Life', url: '/tags/farm-life/' },
  { name: 'Farming Wisdom', url: '/tags/farming-wisdom/' },
];
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div>
      <h2>Winkky Farms</h2>
      <p>
        Where family, land, and tradition meet. Three generations of farming wisdom, seasonal
        stories from the fields, and the simple joys of life lived close to the land.
      </p>
      <p class="site-footer__disclosure">
        Disclosure: some stories contain affiliate links. If you buy through them, we may earn a
        small commission at no extra cost to you — we only recommend tools we actually use.
      </p>
    </div>
    <nav aria-label="Footer">
      <h3>Explore</h3>
      <ul>
        {explore.map((item) => <li><a href={item.url}>{item.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="From the fields">
      <h3>From the Fields</h3>
      <ul>
        {fields.map((item) => <li><a href={item.url}>{item.name}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap site-footer__base">
    <span>&copy; {year} Winkky Farms · Grown with care in Zone 6a</span>
    <span>Rebuilt as a modern static site</span>
  </div>
</footer>
